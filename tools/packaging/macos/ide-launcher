#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
APP_CONTENTS_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
RES_DIR="$APP_CONTENTS_DIR/Resources"
HOME_DIR="${HOME:-/tmp}"
LOG_DIR="${HOME_DIR}/Library/Logs/IDE"
LOG_FILE="$LOG_DIR/launcher.log"
RUNTIME_DIR_DEFAULT="${HOME_DIR}/Library/Application Support/IDE/runtime"
RUNTIME_DIR_FALLBACK="${TMPDIR:-/tmp}/IDE/runtime"
RUNTIME_DIR_SOURCE="default"

runtime_dir_is_safe_path() {
    candidate="$1"
    [ -n "$candidate" ] || return 1
    case "$candidate" in
        /*) ;;
        *) return 1 ;;
    esac
    case "$candidate" in
        *"/../"*|*"/.."|*"../"*) return 1 ;;
    esac
    case "$candidate" in
        "/"|"/tmp"|"/private/tmp"|"$HOME_DIR"|"$HOME_DIR/"|"$HOME_DIR/Library"|"$HOME_DIR/Library/Application Support"|"$APP_CONTENTS_DIR"|"$RES_DIR")
            return 1
            ;;
    esac
    return 0
}

runtime_dir_prepare() {
    candidate="$1"
    runtime_source="$2"
    runtime_dir_is_safe_path "$candidate" || return 1
    mkdir -p "$candidate" 2>/dev/null || return 1
    resolved="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
    runtime_dir_is_safe_path "$resolved" || return 1
    RUNTIME_DIR="$resolved"
    RUNTIME_DIR_SOURCE="$runtime_source"
    return 0
}

if [ "${IDE_RUNTIME_DIR+x}" = "x" ]; then
    if ! runtime_dir_prepare "$IDE_RUNTIME_DIR" "env"; then
        if ! runtime_dir_prepare "$RUNTIME_DIR_DEFAULT" "default_after_invalid_env"; then
            runtime_dir_prepare "$RUNTIME_DIR_FALLBACK" "tmp_after_invalid_env" || RUNTIME_DIR="$RUNTIME_DIR_FALLBACK"
        fi
    fi
else
    if ! runtime_dir_prepare "$RUNTIME_DIR_DEFAULT" "default"; then
        runtime_dir_prepare "$RUNTIME_DIR_FALLBACK" "tmp" || RUNTIME_DIR="$RUNTIME_DIR_FALLBACK"
    fi
fi

ensure_bundle_copy() {
    target="$1"
    source="$2"
    required_rels="${3:-}"
    if [ -L "$target" ]; then
        rm -rf "$target" 2>/dev/null || true
    fi
    if [ -e "$target" ] && [ -n "$required_rels" ]; then
        old_ifs="${IFS}"
        IFS=':'
        all_present=1
        for required_rel in $required_rels; do
            if [ ! -e "$target/$required_rel" ]; then
                all_present=0
                break
            fi
        done
        IFS="${old_ifs}"
        if [ "$all_present" -eq 1 ]; then
            return 0
        fi
        rm -rf "$target" 2>/dev/null || true
    fi
    [ -e "$source" ] || return 0
    mkdir -p "$(dirname "$target")" 2>/dev/null || true
    if [ -d "$source" ]; then
        /usr/bin/ditto "$source" "$target"
    else
        cp "$source" "$target"
    fi
}

ensure_bundle_link() {
    target="$1"
    source="$2"
    if [ -L "$target" ] || [ ! -e "$target" ]; then
        ln -sfn "$source" "$target"
    fi
}

mkdir -p "$RUNTIME_DIR/vk" "$RUNTIME_DIR/config/shared/shaders" 2>/dev/null || true
ensure_bundle_copy "$RUNTIME_DIR/shaders" "$RES_DIR/shaders" "textured.vert.spv:textured.frag.spv:line.vert.spv:line.frag.spv:fill.vert.spv:fill.frag.spv"
ensure_bundle_copy "$RUNTIME_DIR/vk_renderer" "$RES_DIR/vk_renderer" "shaders/textured.vert.spv:shaders/textured.frag.spv:shaders/line.vert.spv:shaders/line.frag.spv:shaders/fill.vert.spv:shaders/fill.frag.spv"
ensure_bundle_link "$RUNTIME_DIR/config/shared/shaders/vk_renderer" "$RUNTIME_DIR/vk_renderer"

export IDE_RESOURCE_ROOT="${IDE_RESOURCE_ROOT:-$RES_DIR}"
export IDE_RUNTIME_DIR="$RUNTIME_DIR"
export VK_RENDERER_SHADER_ROOT="${VK_RENDERER_SHADER_ROOT:-$RUNTIME_DIR}"
export IDE_TIMER_HUD_SETTINGS="${IDE_TIMER_HUD_SETTINGS:-$IDE_RUNTIME_DIR/timerhud/ide/settings.json}"
export IDE_TIMER_HUD="${IDE_TIMER_HUD:-0}"

MOLTENVK_DYLIB="$APP_CONTENTS_DIR/Frameworks/libMoltenVK.dylib"
ICD_FILE="$RUNTIME_DIR/vk/MoltenVK_icd.json"
cat >"$ICD_FILE" <<EOF
{
  "file_format_version": "1.0.0",
  "ICD": {
    "library_path": "$MOLTENVK_DYLIB",
    "api_version": "1.3.0"
  }
}
EOF
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-$ICD_FILE}"
export VK_DRIVER_FILES="${VK_DRIVER_FILES:-$ICD_FILE}"
export MOLTENVK_DYLIB

mkdir -p "$LOG_DIR" 2>/dev/null || true
if ! touch "$LOG_FILE" 2>/dev/null; then
    LOG_FILE="${TMPDIR:-/tmp}/ide-launcher.log"
    touch "$LOG_FILE" 2>/dev/null || true
fi

if [ "${1:-}" = "--print-config" ]; then
    echo "APP_CONTENTS_DIR=$APP_CONTENTS_DIR"
    echo "RES_DIR=$RES_DIR"
    echo "LOG_FILE=$LOG_FILE"
    echo "IDE_RUNTIME_DIR=$IDE_RUNTIME_DIR"
    echo "IDE_RUNTIME_DIR_SOURCE=$RUNTIME_DIR_SOURCE"
    echo "IDE_RESOURCE_ROOT=$IDE_RESOURCE_ROOT"
    echo "IDE_TIMER_HUD_SETTINGS=$IDE_TIMER_HUD_SETTINGS"
    echo "IDE_TIMER_HUD=$IDE_TIMER_HUD"
    echo "IDE_TIMER_HUD_OVERLAY=${IDE_TIMER_HUD_OVERLAY:-}"
    echo "IDE_TIMER_HUD_VISUAL_MODE=${IDE_TIMER_HUD_VISUAL_MODE:-}"
    echo "VK_RENDERER_SHADER_ROOT=$VK_RENDERER_SHADER_ROOT"
    echo "VK_ICD_FILENAMES=$VK_ICD_FILENAMES"
    echo "VK_DRIVER_FILES=$VK_DRIVER_FILES"
    echo "MOLTENVK_DYLIB=$MOLTENVK_DYLIB"
    exit 0
fi

if [ "${1:-}" = "--self-test" ]; then
    [ -x "$SCRIPT_DIR/ide-bin" ] || { echo "missing: ide-bin" >&2; exit 1; }
    [ -x "$SCRIPT_DIR/idebridge" ] || { echo "missing: idebridge" >&2; exit 1; }
    [ -f "$APP_CONTENTS_DIR/Frameworks/libvulkan.1.dylib" ] || { echo "missing: bundled libvulkan" >&2; exit 1; }
    [ -f "$APP_CONTENTS_DIR/Frameworks/libMoltenVK.dylib" ] || { echo "missing: bundled libMoltenVK" >&2; exit 1; }
    [ -f "$RES_DIR/include/fonts/Lato/Lato-Regular.ttf" ] || { echo "missing: bundled Lato font" >&2; exit 1; }
    [ -f "$RUNTIME_DIR/vk_renderer/shaders/textured.vert.spv" ] || { echo "missing: runtime vk textured shader" >&2; exit 1; }
    [ -f "$RUNTIME_DIR/vk_renderer/shaders/line.vert.spv" ] || { echo "missing: runtime vk line shader" >&2; exit 1; }
    [ -f "$RUNTIME_DIR/vk_renderer/shaders/line.frag.spv" ] || { echo "missing: runtime vk line shader" >&2; exit 1; }
    [ -f "$RUNTIME_DIR/shaders/textured.vert.spv" ] || { echo "missing: runtime textured shader" >&2; exit 1; }
    [ -f "$RUNTIME_DIR/shaders/line.vert.spv" ] || { echo "missing: runtime line shader" >&2; exit 1; }
    [ -f "$RUNTIME_DIR/shaders/line.frag.spv" ] || { echo "missing: runtime line shader" >&2; exit 1; }
    [ -f "$ICD_FILE" ] || { echo "missing: runtime MoltenVK_icd.json" >&2; exit 1; }
    echo "self-test: ok"
    echo "LOG_FILE=$LOG_FILE"
    echo "IDE_RUNTIME_DIR=$IDE_RUNTIME_DIR"
    echo "IDE_RUNTIME_DIR_SOURCE=$RUNTIME_DIR_SOURCE"
    echo "IDE_RESOURCE_ROOT=$IDE_RESOURCE_ROOT"
    echo "IDE_TIMER_HUD_SETTINGS=$IDE_TIMER_HUD_SETTINGS"
    echo "IDE_TIMER_HUD=$IDE_TIMER_HUD"
    echo "IDE_TIMER_HUD_OVERLAY=${IDE_TIMER_HUD_OVERLAY:-}"
    echo "IDE_TIMER_HUD_VISUAL_MODE=${IDE_TIMER_HUD_VISUAL_MODE:-}"
    echo "VK_RENDERER_SHADER_ROOT=$VK_RENDERER_SHADER_ROOT"
    echo "VK_ICD_FILENAMES=$VK_ICD_FILENAMES"
    echo "VK_DRIVER_FILES=$VK_DRIVER_FILES"
    echo "MOLTENVK_DYLIB=$MOLTENVK_DYLIB"
    exit 0
fi

printf '%s launch begin pid=%s cwd=%s runtime_dir=%s resource_root=%s shader_root=%s args=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$$" "$RUNTIME_DIR" "$IDE_RUNTIME_DIR" "$IDE_RESOURCE_ROOT" "$VK_RENDERER_SHADER_ROOT" "$*" >>"$LOG_FILE" 2>/dev/null || true
cd "$RUNTIME_DIR"
exec "$SCRIPT_DIR/ide-bin" "$@" >>"$LOG_FILE" 2>&1
